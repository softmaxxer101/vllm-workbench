# ---------------------------------------------------------------------------
# vLLM Workbench configuration
# Copy to .env before running Docker Compose (never commit the real file).
# ---------------------------------------------------------------------------

# Optional. Protect /v1/* with `Authorization: Bearer <key>`.
# Generate with: openssl rand -hex 32
WORKBENCH_API_KEY=

# Optional. Required for gated Hugging Face models (Llama, Mistral some sizes).
HF_TOKEN=

# URL the *browser* uses to reach the FastAPI backend. This is baked into the
# frontend at build time; rebuild with `docker compose build frontend` to change.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Browser origins allowed to call the backend (comma separated).
WORKBENCH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# How long model loading may take before the backend gives up (seconds).
WORKBENCH_STARTUP_TIMEOUT_S=900

# vLLM Docker image tag used by the backend build.
VLLM_VERSION=0.32.0
